# --- API (python -m api) ---
DB_HOST=host
DB_PORT=porta
DB_NAME=nome
DB_USER=usuario
DB_PASSWORD=senha
SECRET_KEY=gere-uma-chave-aleatoria-para-producao
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
CORS_ORIGIN=http://127.0.0.1:8000

# --- Servidor das páginas (python -m frontend.servidor) ---
# Endereço da API Flask que o proxy encaminha
API_URL=http://127.0.0.1:5000
# Porta deste servidor (opcional, padrão 8000)
PORT=8000

# Defina FLASK_DEBUG=1 apenas em desenvolvimento
