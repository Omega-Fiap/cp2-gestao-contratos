    "/contratos/{id}/analisar": {
      "post": {
        "tags": [
          "contratos"
        ],
        "summary": "Analisa apenas as descricoes das clausulas do contrato proprio",
        "description": "Envia texto contratual sem os dados do cliente. O resultado estruturado e validado e reutilizado enquanto o texto das clausulas nao mudar. Requer GEMINI_API_KEY no servidor.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "201": {
            "description": "Nova analise persistida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultadoAnalise"
                }
              }
            }
          },
          "200": {
            "description": "Analise salva reutilizada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultadoAnalise"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Erro"
          },
          "401": {
            "$ref": "#/components/responses/Erro"
          },
          "404": {
            "$ref": "#/components/responses/Erro"
          },
          "422": {
            "$ref": "#/components/responses/Erro"
          },
          "502": {
            "$ref": "#/components/responses/Erro"
          }
        }
      }
    },
    "/contratos/{id}/analise": {
      "get": {
        "tags": [
          "contratos"
        ],
        "summary": "Consulta analise salva de contrato proprio sem chamar o Gemini",
