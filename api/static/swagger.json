{
  "openapi": "3.0.3",
  "info": {
    "title": "Omega - Gestao de Contratos API",
    "version": "2.0.0",
    "description": "API de gestao de contratos. Recursos de carteira exigem token Bearer. Os dados do usuario sao determinados pelo token; usuario_id nao e aceito no corpo."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:5000",
      "description": "Desenvolvimento local"
    }
  ],
  "tags": [
    {
      "name": "auth",
      "description": "Cadastro, login e sessao"
    },
    {
      "name": "contratos",
      "description": "Contratos e recursos vinculados a carteira"
    },
    {
      "name": "dashboard",
      "description": "Indicadores agregados da carteira autenticada"
    },
    {
      "name": "clausulas",
      "description": "Clausulas vinculadas a contratos do usuario"
    },
    {
      "name": "clientes",
      "description": "Clientes privados por carteira"
    },
    {
      "name": "formulario",
      "description": "Cadastro autenticado de contrato e clausulas"
    },
    {
      "name": "aditivos",
      "description": "Aditivos contratuais"
    },
    {
      "name": "historico-status",
      "description": "Historico de status dos contratos"
    },
    {
      "name": "usuarios",
      "description": "Usuarios (admin)"
    }
  ],
  "paths": {
    "/auth/registrar": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Cria uma conta de usuario",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Registro"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Conta criada com papel usuario",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usuario"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Erro"
          },
          "409": {
            "$ref": "#/components/responses/Erro"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Inicia sessao",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token e perfil",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sessao"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Erro"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Retorna o perfil autenticado",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Perfil do usuario",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usuario"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Erro"
          }
        }
      }
    },
    "/contratos": {
      "get": {
        "tags": [
          "contratos"
        ],
        "summary": "Lista contratos da carteira autenticada",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tipo_contrato",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "description": "Busca por numero, titulo ou nome do cliente",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pagina de contratos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaContratos"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Erro"
          },
          "401": {
            "$ref": "#/components/responses/Erro"
          }
        }
      },
      "post": {
        "tags": [
          "contratos"
        ],
        "summary": "Cria contrato na carteira autenticada",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NovoContrato"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Contrato criado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Contrato"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Erro"
          },
          "404": {
            "$ref": "#/components/responses/Erro"
          }
        }
      }
    },
    "/contratos/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Id"
        }
      ],
      "get": {
        "tags": [
          "contratos"
