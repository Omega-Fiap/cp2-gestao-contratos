            }
          }
        },
        "responses": {
          "200": {
            "description": "Contrato atualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Contrato"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Erro"
          },
          "404": {
            "$ref": "#/components/responses/Erro"
          }
        }
      },
      "delete": {
        "tags": [
          "contratos"
        ],
        "summary": "Exclui contrato proprio e seus registros dependentes",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Contrato removido"
          },
          "401": {
            "$ref": "#/components/responses/Erro"
          },
          "404": {
            "$ref": "#/components/responses/Erro"
          }
        }
      }
    },
