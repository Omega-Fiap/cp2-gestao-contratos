                "properties": {
                  "cliente": {
                    "$ref": "#/components/schemas/NovoCliente"
                  },
                  "contrato": {
                    "$ref": "#/components/schemas/NovoContratoFormulario"
                  },
                  "clausulas": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/NovaClausulaFormulario"
                    }
                  }
                }
              }
            }
          }
        },
